PORT=8080

# Threadpool size (default 8, increase on high-RAM VPS)
THREADPOOL_SIZE=8

# Get it from telegram BotFather
BOT_TOKEN=

# Git it from telegram devopers website
APP_ID=
API_HASH=

# Get telegram details
STORAGE_GROUP_ID=
ADMIN_ID=
# Telegram supergroups and channels have negative IDs internally. The 3843778132 you had is just the bare numeric part — the full API-compatible ID always has a -100 prefix, making it -1003843778132. Without the prefix, Telethon interprets it as a regular user ID (PeerUser) and fails to resolve it.

# Firebase Firestore
FIREBASE_SECRETS=

# From Terabox website.
# Multiple cookies form a rotation pool: on 429/403 rate-limits the bot
# automatically invalidates the current cookie and tries the next one.
COOKIES1=
COOKIES2=
COOKIES3=
COOKIES4=
...

THIRD_PARTY_TERABOXDL_URL=
PROXY_URL=

# Diskwala scraper proxy (POST endpoint, api key sent as the x-api-key header)
DISKWALA_PROXY_URL=
DISKWALA_API_KEY=

# ── Optional tuning ─────────────────────────────────────────────────────────————————————————
# Per-user retry budget: after MAX_FAILURES_PER_WINDOW failures within
# FAILURE_WINDOW_SECONDS, the user is blocked for FAILURE_COOLDOWN_SECONDS.
MAX_FAILURES_PER_WINDOW=5
FAILURE_WINDOW_SECONDS=600
FAILURE_COOLDOWN_SECONDS=600

# Max links processed per message (extra links are dropped with a notice)
MAX_LINKS_PER_MESSAGE=5

# Skip files larger than this many MB (0 = unlimited). Applies to /exp and /dw.
MAX_FILE_SIZE_MB=0

# Size cap for /dl universal hosts in MB (default 2048 = 2 GB)
UNIVERSAL_MAX_SIZE_MB=2048

# Max simultaneous downloads per non-admin user (admins exempt; 0 = unlimited)
USER_MAX_CONCURRENT=2
